<div class="plant-form-container">
  <h1 class="form-title">🌿 Edit <%= @plant.name %></h1>

  <%= form_with model: @plant, local: true, class: "plant-form" do |f| %>
    <div class="form-group">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :species, class: "form-label" %>
      <%= f.text_field :species, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :location, class: "form-label" %>
      <%= f.text_field :location, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :watering_frequency, "Watering Frequency (days)", class: "form-label" %>
      <%= f.number_field :watering_frequency, required: true, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Update Plant", class: "btn btn-primary" %>
      <%= link_to "Cancel", plant_path(@plant), class: "btn btn-cancel" %>
    </div>
  <% end %>
</div>

