<div class="plant-form-container">
  <h1 class="form-title">🌱 Add a New Plant</h1>

  <%= form_with model: @plant, local: true, class: "plant-form" do |form| %>
    <div class="form-group">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :species, class: "form-label" %>
      <%= form.text_field :species, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :location, class: "form-label" %>
      <%= form.text_field :location, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :watering_frequency, "Watering Frequency (days)", class: "form-label" %>
      <%= form.number_field :watering_frequency, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :last_watered_at, "Last Watered On", class: "form-label" %>
      <%= form.date_field :last_watered_at, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Create Plant", class: "btn btn-primary" %>
      <%= link_to "Cancel", plants_path, class: "btn btn-cancel" %>
    </div>
  <% end %>
</div>
