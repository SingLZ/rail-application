<div class="plants-container">
  <h1 class="page-title">🌿 My Plants</h1>

  <% if @plants.any? %>
    <ul class="plant-list">
      <% @plants.each do |plant| %>
        <li class="plant-card">
          <div class="plant-info">
            <h2><%= plant.name %></h2>
            <p><strong>Species:</strong> <%= plant.species %></p>
            <p><strong>Added by:</strong> <%= plant.user.full_name %></p>
          </div>

          <div class="plant-actions">
            <%= link_to "View", plant_path(plant), class: "btn btn-view" %>
            <%= link_to "Edit", edit_plant_path(plant), class: "btn btn-edit" %>
            <%= button_to "Delete", plant_path(plant),
        method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this plant?" },
        class: "btn btn--danger" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">You haven’t added any plants yet 🌱</p>
  <% end %>

  <div class="actions">
    <%= link_to "➕ Add New Plant", new_plant_path, class: "btn btn-primary" %>
    <%= link_to "← Back to Dashboard", dashboard_path, class: "btn btn-secondary" %>
  </div>
</div>
