<div class="login-container">
  <h1 class="login-title">🌿 Plant Tracker Login</h1>

  <% if flash[:alert] %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with(url: session_path, local: true, class: "login-form") do |form| %>
    <div class="form-group">
      <%= form.label :email, class: "form-label" %>
      <%= form.text_field :email, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: true, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Login", class: "btn btn-primary" %>
    </div>
  <% end %>

  <p class="signup-link">
    Don’t have an account?
    <%= link_to "Register here", new_user_path, class: "btn-link" %>
  </p>
</div>
