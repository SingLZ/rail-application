<div class="signup-container">
  <h1 class="signup-title">🌱 Create Your Plant Tracker Account</h1>

  <% if flash[:alert] %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with model: @user, url: users_path, local: true, class: "signup-form" do |f| %>
    <div class="form-group">
      <%= f.label :first_name, class: "form-label" %>
      <%= f.text_field :first_name, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :last_name, class: "form-label" %>
      <%= f.text_field :last_name, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, required: true, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, required: true, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Create Account", class: "btn btn-primary" %>
    </div>
  <% end %>

  <p class="login-link">
    Already have an account?
    <%= link_to "Log in here", new_session_path, class: "btn-link" %>
  </p>
</div>
